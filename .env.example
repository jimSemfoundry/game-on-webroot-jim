# ENV Example:

# 用于请求后端接口地址的URL
# VITE_API_URL=http://localhost:3001/api
# VITE_API_URL=https://api.yourdomain.com/v1
VITE_API_URL=http://api-server-domain

# Image/Assets Domain
# 用于获取图片资源的OSS/R2/iamgeix等图床地址
VITE_IMAGE_URL=http://image-service-domain

# Logo/Favicon 外链资源地址（可选）
# 例如: https://cdn.yourdomain.com
VITE_LOGO_BASE_URL=https://cdn.example.com/assets # Logo 资源外链基地址（不带 theme）
VITE_FAVICON_BASE_URL=https://cdn.example.com/assets # Favicon 资源外链基地址（带 theme）

# Logo 直接 URL（可选，优先级高于 BASE_URL）
VITE_LOGO_FULL_URL= # Header/页面 Logo 完整 URL
VITE_LOGO_PWA_URL= # 旧 UI 品牌图完整 URL（不参与 manifest 图标生成）
VITE_LOGO_LOADER_URL= # 启动页 Loader Logo 完整 URL

# Favicon 直接 URL（可选，优先级高于 BASE_URL）
VITE_FAVICON_PNG_URL= # favicon-192x192 完整 URL
VITE_FAVICON_SVG_URL= # favicon.svg 完整 URL
VITE_FAVICON_ICO_URL= # favicon.ico 完整 URL
VITE_FAVICON_APPLE_URL= # apple-touch-icon 完整 URL

# 用于获取语言包的url
VITE_LOCALES_URL=https://ng-locales-prod.pages.dev

# Betby SDK 脚本地址（可选）
# 不填时默认使用生产地址：https://1stgame.sptpub.com/bt-renderer.min.js
# 测试环境可设置为：https://ui.invisiblesport.com/bt-renderer.min.js
VITE_BETBY_SDK_URL=

# Theme配置，详情参考文档: /docs/theme.md
VITE_THEME_CONFIG='{"currentTheme":"dark","customOverrides":{"colors":{"primary":"oklch(80% 0.2 50)"}}}'

VITE_THEME= #  gameOn | 1stgame | 1stwin

VITE_WEBSITE_NAME_BLOCK=GAME.ON  #网站标题名称

VITE_WEBSITE_NICKNAME=1st.game #网站 NICKNAME 

VITE_WEBSITE_NICKNAME_LEFT=GAME #网站 NICKNAME 左边

VITE_WEBSITE_NICKNAME_RIGHT=.ON #网站 NICKNAME 右边

VITE_FACEBOOK_PIXEL_ID= #网站 FACEBOOK_PIXEL_ID

# Facebook App ID（用于 Messenger Send Dialog 分享，可选，无则降级为 Facebook 公开分享）
# VITE_FACEBOOK_APP_ID=

# Google Tag Manager ID（可选）
# 例如: GTM-PSK2JC2T
VITE_GTM_ID=

# Alibaba Cloud RUM（可选）
# 用于前端 RUM 埋点 pid，例如: 1i6y71lx74v@06e3adcf022df54
VITE_ALIBABA_RUM_ID=

# 用于前端 RUM 埋点 ENDPOINT
VITE_ALIBABA_RUM_ENDPOINT=

VITE_PROMOTION_MODEL=    # 不填默认 prod | roibest | landing

# 是否隐藏联盟合作模块（casino 页面）
VITE_HIDE_ALLIANCE_PARTNERSHIPS=false

VITE_FOLDER=  # roibest 的 appid

VITE_WEBSITE_URL= 

VITE_WEBSITE_SUPPORT_NAME=OKVIP # 合作商

VITE_BUSINESS_EMAIL=business@1st.game  # 合作邮箱


# 以下是富文本的抽出基本不用修改，不用添加
VITE_WEBSITE_SUPPORT_EMAIL=support@1st.game

VITE_WEBSITE_ANONYMOUS=https://gamblersanonymous.org/ga/

VITE_WEBSITE_THERAPY=https://www.gamblingtherapy.org/

VITE_WEBSITE_THERAPY_EMAIL=support@gamblingtherapy.org

VITE_WEBSITE_CHAT=https://www.ncpgambling.org/help-treatment/chat/

VITE_WEBSITE_SUPPORT=https://www.gamtalk.org/treatment-support/

VITE_WEBSITE_TEL=+18004262537

VITE_WEBSITE_BLOCKS_URL=https://www.betblocker.org/

VITE_WEBSITE_NETNANNY_URL=https://www.netnanny.com/

VITE_WEBSITE_GAMBLOCK_URL=http://www.gamblock.com/

# SEO 配置（可选）
VITE_SEO_TITLE=GAME.ON - Challenge Everything # 页面标题
VITE_SEO_DESCRIPTION=Enter the world of GAME.ON - your premier crypto entertainment hub. Play instantly, earn exclusive rewards, rise through the ranks, and challenge everything. No limits. Just the thrill. # 页面描述
VITE_SEO_OG_TITLE=GAME.ON - Challenge Everything # Open Graph 标题
VITE_SEO_OG_DESCRIPTION=Enter the world of GAME.ON - your premier crypto entertainment hub. Play instantly, earn exclusive rewards, rise through the ranks, and challenge everything. No limits. Just the thrill. # Open Graph 描述
VITE_SEO_OG_IMAGE=https://images.unsplash.com/photo-1545239351-1141bd82e8a6?q=80&w=1000&auto=format&fit=crop # Open Graph 图片地址
VITE_SEO_OG_IMAGE_WIDTH=1000 # Open Graph 图片宽度
VITE_SEO_OG_IMAGE_HEIGHT=1000 # Open Graph 图片高度
VITE_SEO_OG_SITE_NAME=GAME.ON # Open Graph 站点名

# PWA 配置（可选）
VITE_PWA_NAME=GAME.ON # PWA 应用名称
VITE_PWA_SHORT_NAME=GAME.ON # PWA 短名称
VITE_PWA_DESCRIPTION=Play instantly, earn exclusive rewards, rise through the ranks, and challenge everything. # PWA 描述
VITE_PWA_THEME_COLOR=#0f1419 # PWA 主题色
VITE_PWA_BACKGROUND_COLOR=#0f1419 # PWA 背景色
VITE_PWA_STATUS_BAR_STYLE=black-translucent # iOS 状态栏样式
VITE_PWA_START_URL=/main/casino # PWA 启动路径
VITE_PWA_SCOPE=/ # PWA scope
VITE_PWA_ID=/pwa-main # PWA manifest id
VITE_PWA_ICON_192_URL= # PWA 192 图标 URL（优先于 favicon png）
VITE_PWA_ICON_512_URL= # PWA 512 图标 URL
VITE_PWA_MASKABLE_ICON_192_URL= # PWA 192 maskable 图标 URL
VITE_PWA_MASKABLE_ICON_512_URL= # PWA 512 maskable 图标 URL
VITE_PWA_APPLE_ICON_URL= # PWA apple touch 图标 URL（优先于 VITE_FAVICON_APPLE_URL）

# Hero 插画配置（可选，空则使用默认图）
VITE_BONUS_HERO_IMAGE=https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1200&auto=format&fit=crop # Bonus 页 Hero 插画
VITE_REFERRAL_HERO_IMAGE=https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80&w=1200&auto=format&fit=crop # Referral 页 Hero 插画
VITE_TOURNAMENT_HERO_IMAGE=https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=1200&auto=format&fit=crop # Tournament 页 Hero 插画
VITE_VIP_HERO_AUTH_CHARACTER_IMAGE=https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1200&auto=format&fit=crop # VIP 已登录 Hero 插画

# Casino 未登录 Banner 插画（可选）
VITE_CASINO_UNAUTH_BANNER_IMAGE_DESKTOP_URL=https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1200&auto=format&fit=crop # 桌面端插画完整 URL
VITE_CASINO_UNAUTH_BANNER_IMAGE_MOBILE_URL=https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80&w=600&auto=format&fit=crop # 移动端插画完整 URL

# 注册弹窗宣传图片（可选）
VITE_SIGNUP_MODAL_IMAGE= # 注册弹窗左侧宣传图片 URL

# 首次推荐奖励的人物图片（可选）
VITE_FIRST_REFERRAL_MODAL_IMAGE= # 首次推荐奖励的人物图片 URL

# 个人中心 Banner 图片（可选）
VITE_USER_PROFILE_IMAGE= # 个人中心 Banner 图片 URL
