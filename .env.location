# ENV Example:

# 用于请求后端接口地址的URL
# VITE_API_URL=http://localhost:3001/api
# VITE_API_URL=https://api.yourdomain.com/v1
VITE_API_URL=http://api-server-domain

# Image/Assets Domain
# 用于获取图片资源的OSS/R2/iamgeix等图床地址
VITE_IMAGE_URL=http://image-service-domain

# 用于获取语言包的url
VITE_LOCALES_URL=https://ng-locales-prod.pages.dev

# Theme配置，详情参考文档: /docs/theme.md
VITE_THEME_CONFIG='{"currentTheme":"dark","customOverrides":{"colors":{"primary":"oklch(80% 0.2 50)"}}}'

VITE_THEME= #  gameOn | 1stgame | 1stwin

VITE_WEBSITE_NAME_BLOCK=GAME.ON  #网站标题名称

VITE_WEBSITE_NICKNAME=1st.game #网站 NICKNAME 

VITE_WEBSITE_NICKNAME_LEFT=GAME #网站 NICKNAME 左边

VITE_WEBSITE_NICKNAME_RIGHT=.ON #网站 NICKNAME 右边

VITE_FACEBOOK_PIXEL_ID= #网站 FACEBOOK_PIXEL_ID

VITE_PROMOTION_MODEL=    # 不填默认 prod | roibest | landing

VITE_FOLDER=  # roibest 的 appid

VITE_WEBSITE_URL= 

VITE_WEBSITE_SUPPORT_NAME=OKVIP # 合作商

VITE_BUSINESS_EMAIL=business@1st.game  # 合作邮箱


# 以下是富文本的抽出基本不用修改，不用添加
VITE_WEBSITE_SUPPORT_EMAIL=support@1st.game

VITE_WEBSITE_ANONYMOUS=https://gamblersanonymous.org/ga/

VITE_WEBSITE_THERAPY=https://www.gamblingtherapy.org/

VITE_WEBSITE_THERAPY_EMAIL=support@gamblingtherapy.org

VITE_WEBSITE_CHAT=https://www.ncpgambling.org/help-treatment/chat/

VITE_WEBSITE_SUPPORT=https://www.gamtalk.org/treatment-support/

VITE_WEBSITE_TEL=+18004262537

VITE_WEBSITE_BLOCKS_URL=https://www.betblocker.org/

VITE_WEBSITE_NETNANNY_URL=https://www.netnanny.com/

VITE_WEBSITE_GAMBLOCK_URL=http://www.gamblock.com/

